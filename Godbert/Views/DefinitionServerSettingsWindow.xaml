<Window x:Class="Godbert.Views.DefinitionServerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Definition Server" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
            Configure the definition-sharing server. Reads are public; your username and PIN are only
            needed to submit changes. Leave the URL blank to disable all sharing.
        </TextBlock>

        <TextBlock Text="Server URL" Margin="0,0,0,2" />
        <TextBox x:Name="UrlBox" />

        <TextBlock Text="Username" Margin="0,10,0,2" />
        <TextBox x:Name="UserBox" />

        <TextBlock Text="PIN" Margin="0,10,0,2" />
        <PasswordBox x:Name="PinBox" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="84" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" Width="84" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
