<UserControl x:Class="Godbert.Views.ImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ctrl="clr-namespace:Godbert.Controls"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:godbert="clr-namespace:Godbert"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">

    <UserControl.Resources>
        <ContextMenu x:Key="IconSetContextMenu">
            <MenuItem Header="Export all Images" Command="{Binding ExportIconSetCommand}" CommandParameter="">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedIconSet}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Export all Images (Hr1)" Command="{Binding ExportIconSetCommand}" CommandParameter="_hr1">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedIconSet}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem Header="Add remark…" Command="{Binding AddRemarkCommand}" CommandParameter="">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedIconSet}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="IconContextMenu">
            <MenuItem Header="Export" Command="{Binding ExportIconCommand}" CommandParameter="">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedIcon}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Export (Hr1)" Command="{Binding ExportIconCommand}" CommandParameter="_hr1">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedIcon}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
        </ContextMenu>
        <ctrl:MinDimensionConverter x:Key="MinConverter"/>

        <DataTemplate x:Key="IconSetItemTemplate">
            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DockPanel LastChildFill="True" Grid.Column="0">
            <TextBox Text="{Binding Path=FilterImageTerm, Mode=TwoWay, Delay=250, UpdateSourceTrigger=PropertyChanged}"
                        DockPanel.Dock="Top"
                        Margin="0,0,0,2"></TextBox>
            <ComboBox ItemsSource="{Binding Patches}" SelectedItem="{Binding SelectedPatch, Mode=TwoWay}"
                    DockPanel.Dock="Top" Margin="0,0,0,2"
                      SelectionChanged="PatchSelectionChanged"/>
            <ListBox x:Name="IconSets"
                ItemsSource="{Binding FilteredIconSets}"
                        SelectedValuePath="Id"
                        SelectedValue="{Binding SelectedIconSet, Mode=TwoWay}"
                        ItemTemplate="{StaticResource IconSetItemTemplate}"
                        HorizontalAlignment="Stretch"
                        ContextMenu="{StaticResource IconSetContextMenu}"
                     SelectionChanged="IconSetSelectionChanged"/>
        </DockPanel>

        <GridSplitter Width="4" Grid.Column="1"
                      IsEnabled="{Binding ElementName=SelectionExpander, Path=IsExpanded}"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <ctrl:MultipleSelectionListBox x:Name="IconGallery"
                     Grid.Column="2"
                     ItemsSource="{Binding Icons}"
                     SelectedItem="{Binding SelectedIcon, Mode=TwoWay}"
                     BindableSelectedItems="{Binding SelectedIcons}"
                     ContextMenu="{StaticResource IconContextMenu}"
                     SelectionMode="Extended"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     HorizontalContentAlignment="Left">
                <ctrl:MultipleSelectionListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel Orientation="Horizontal" 
                                       SpacingMode="BetweenItemsOnly"
                                       StretchItems="False"/>
                    </ItemsPanelTemplate>
                </ctrl:MultipleSelectionListBox.ItemsPanel>

                <ctrl:MultipleSelectionListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" 
                    Background="#2D2D2D" 
                    CornerRadius="4"
                    ToolTip="{Binding DisplayId}"
                    HorizontalAlignment="Left">

                            <Grid MaxHeight="{Binding ElementName=IconGallery, Path=ActualHeight}" MaxWidth="{Binding ElementName=IconGallery, Path=ActualWidth}">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                            <Image Source="{Binding Bitmap}" 
                           Grid.Row="0"
                           Stretch="Uniform"
                           StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="LowQuality"
                           Margin="0 5 0 0">
                            </Image>

                                <TextBlock Grid.Row="1" 
                               Text="{Binding DisplayId}" 
                               HorizontalAlignment="Center" 
                               Foreground="White" 
                               FontSize="15"
                               Margin="5,5,5,5"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ctrl:MultipleSelectionListBox.ItemTemplate>
            </ctrl:MultipleSelectionListBox>

            <GridSplitter Width="4" Grid.Column="3"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" />

        
    </Grid>
</UserControl>
